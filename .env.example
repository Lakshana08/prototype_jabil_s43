# Copy to your shell / deployment environment. Do NOT commit real credentials.

SAP_ODATA_BASE_URL=https://192.168.8.69:44300/sap/opu/odata/sap/ZSB_SMC_MATERIAL_V2
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=

# true | false (accept self-signed cert, dev only) | path to CA bundle (.pem)
SAP_VERIFY_SSL=true
SAP_TIMEOUT_SECONDS=60

# Re-read S43 every N minutes (0 = only at startup)
DATA_REFRESH_MINUTES=15

# SAP BTP / Cloud Foundry only: read S43 through this destination (Destination + Connectivity
# services must be bound). When set, SAP_ODATA_BASE_URL / SAP_USER / SAP_PASSWORD are ignored.
SAP_DESTINATION_NAME=S43
SAP_ODATA_SERVICE_PATH=/sap/opu/odata/sap/ZSB_SMC_MATERIAL_V2

# SAP AI Core (generative AI hub) - LLM that understands questions and writes answers.
# Leave empty (or LLM_ENABLED=false) to use the rule-based router + answer templates.
AICORE_AUTH_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_RESOURCE_GROUP=default
AICORE_BASE_URL=https://api.ai.prod.<region>.ml.hana.ondemand.com/v2
LLM_DEPLOYMENT_ID=
LLM_HISTORY_TURNS=6
