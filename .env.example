# Copy to your shell / deployment environment. Do NOT commit real credentials.

# odata (live S43, default) | file (offline Sample_data snapshot)
DATA_SOURCE=odata

SAP_ODATA_BASE_URL=https://192.168.8.69:44300/sap/opu/odata/sap/ZSB_SMC_MATERIAL_V2
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=

# true | false (accept self-signed cert, dev only) | path to CA bundle (.pem)
SAP_VERIFY_SSL=true
SAP_TIMEOUT_SECONDS=60

# Re-read S43 every N minutes (0 = only at startup)
DATA_REFRESH_MINUTES=15
